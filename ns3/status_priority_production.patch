+std::deque<LteRlcUm::TxPdu>::iterator
+LteRlcUm::SelectNextSdu()
+{
+    NS_ASSERT(!m_txBuffer.empty());
+    const auto partial = std::find_if(m_txBuffer.begin(),
+                                      m_txBuffer.end(),
+                                      [](const TxPdu& item) { return item.m_isPartial; });
+    NS_ABORT_MSG_IF(partial != m_txBuffer.end() && partial != m_txBuffer.begin(),
+                    "partial RLC UM SDU lost front-of-queue continuity");
+    if (partial != m_txBuffer.end())
+    {
+        EmitSduSelection(*partial, CONTINUE_PARTIAL_SDU);
+        return partial;
+    }
+    if (m_txSduSelectionPolicy == STATUS_PRIORITY_NON_DROPPING)
+    {
+        const auto status = std::find_if(
+            m_txBuffer.begin(),
+            m_txBuffer.end(),
+            [](const TxPdu& item) {
+                return item.m_lineage.instrumented &&
+                       item.m_lineage.trafficClass == LteRlcSduLineageTag::STATUS;
+            });
+        if (status != m_txBuffer.end())
+        {
+            EmitSduSelection(*status, SELECT_STATUS_PRIORITY);
+            return status;
+        }
+    }
+    EmitSduSelection(m_txBuffer.front(), SELECT_FIFO);
+    return m_txBuffer.begin();
+}
+
+void
+LteRlcUm::EmitSduSelection(const TxPdu& selected, SduSelectionAction action)
+{
+    uint32_t statusCount = 0;
+    uint32_t statusBytes = 0;
+    uint32_t otherCount = 0;
+    uint32_t otherBytes = 0;
+    for (const auto& item : m_txBuffer)
+    {
+        if (item.m_lineage.instrumented &&
+            item.m_lineage.trafficClass == LteRlcSduLineageTag::STATUS)
+        {
+            ++statusCount;
+            statusBytes += item.m_pdu->GetSize();
+        }
+        else
+        {
+            ++otherCount;
+            otherBytes += item.m_pdu->GetSize();
+        }
+    }
+    m_sduSelectionTrace(m_rnti,
+                        m_lcid,
+                        static_cast<uint8_t>(m_txSduSelectionPolicy),
+                        static_cast<uint8_t>(action),
+                        selected.m_lineage.lineageId,
+                        selected.m_lineage.trafficClass,
+                        selected.m_lineage.generationTimeNs,
+                        selected.m_waitingSince.GetNanoSeconds(),
+                        selected.m_pdu->GetSize(),
+                        m_txBufferSize,
+                        statusCount,
+                        statusBytes,
+                        otherCount,
+                        otherBytes);
+}
+
+void
+LteRlcUm::EmitSduLineage(const LineageMetadata& metadata,
+                         SduLineageEvent event,
+                         uint64_t rlcPduId,
+                         uint32_t segmentBytes,
+                         SduLineageDisposition disposition)
+{
+    if (!metadata.instrumented)
+    {
+        return;
+    }
+    m_sduLineageTrace(m_rnti,
+                      m_lcid,
+                      static_cast<uint8_t>(event),
+                      metadata.lineageId,
+                      metadata.trafficClass,
+                      metadata.generationTimeNs,
+                      metadata.applicationAttemptTimeNs,
+                      metadata.enqueueTimeNs,
+                      metadata.originalSduBytes,
+                      segmentBytes,
+                      metadata.bytesServedTotal,
+                      metadata.remainingSduBytes,
+                      rlcPduId,
+                      static_cast<uint8_t>(disposition));
+}
+
+void
+LteRlcUm::RecordServiceFragment(LineageMetadata& metadata,
+                                uint32_t segmentBytes,
+                                uint64_t rlcPduId)
+{
+    if (!metadata.instrumented)
+    {
+        return;
+    }
+    NS_ABORT_MSG_IF(segmentBytes == 0, "lineage service fragment must contain bytes");
+    NS_ABORT_MSG_IF(segmentBytes > metadata.remainingSduBytes,
+                    "lineage service bytes exceed remaining SDU bytes");
+    metadata.hasStartedService = true;
+    metadata.bytesServedTotal += segmentBytes;
+    metadata.remainingSduBytes -= segmentBytes;
+    EmitSduLineage(metadata,
+                   LINEAGE_SERVICE_FRAGMENT,
+                   rlcPduId,
+                   segmentBytes,
+                   DISPOSITION_NONE);
+    if (metadata.remainingSduBytes == 0)
+    {
+        NS_ABORT_MSG_IF(metadata.bytesServedTotal != metadata.originalSduBytes,
+                        "lineage byte conservation failed at final service");
+        EmitSduLineage(metadata,
+                       LINEAGE_FULLY_SERVED,
+                       rlcPduId,
+                       0,
+                       DISPOSITION_FULLY_SERVED);
+    }
+}
+
+void
+LteRlcUm::EmitQueueState(QueueEventReason reason, uint32_t affectedBytes)
+{
+    const bool empty = m_txBuffer.empty();
+    const uint64_t holDelayNs =
+        empty ? 0 : static_cast<uint64_t>((Simulator::Now() - m_txBuffer.front().m_waitingSince)
+                                             .GetNanoSeconds());
+    m_queueStateTrace(m_rnti,
+                      m_lcid,
+                      static_cast<uint8_t>(reason),
+                      m_txBufferSize,
+                      static_cast<uint32_t>(m_txBuffer.size()),
+                      holDelayNs,
+                      empty,
+                      affectedBytes);
+}
+
 void
 LteRlcUm::DoNotifyHarqDeliveryFailure()
 {
